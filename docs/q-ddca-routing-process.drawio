  <diagram id="qddca-routing-flow" name="Routing Process">
    <mxGraphModel dx="1422" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Real-Time Q-DDCA Next-Hop Routing Process" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="30" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="Routing decision starts" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="inputs" value="Read destination d, retry budget M, attempts used m, and route table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="190" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="candidates" value="Build feasible neighbor set S&lt;sub&gt;C&lt;/sub&gt;&lt;br&gt;Apply hop, fidelity, and loop constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="300" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dropcost" value="Set drop penalty&lt;br&gt;C&lt;sub&gt;drop&lt;/sub&gt; = 2 d(s,d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="300" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hascandidates" value="Any feasible&lt;br&gt;neighbors?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="410" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="history" value="Historical acceptance&lt;br&gt;q&lt;sub&gt;history&lt;/sub&gt; = (A&lt;sub&gt;v&lt;/sub&gt; + ε) / (T&lt;sub&gt;v&lt;/sub&gt; + ε)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="570" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="memory" value="Live memory utilization&lt;br&gt;ρ&lt;sub&gt;v&lt;/sub&gt;(t) = clamp(M&lt;sub&gt;used&lt;/sub&gt; / M&lt;sub&gt;capacity&lt;/sub&gt;, 0, 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="570" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="blend" value="Blend congestion signals&lt;br&gt;q̂&lt;sub&gt;v&lt;/sub&gt;(t) = αq&lt;sub&gt;history&lt;/sub&gt; + (1−α)(1−ρ&lt;sub&gt;v&lt;/sub&gt;(t))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="700" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="score" value="Score neighbor v&lt;br&gt;R = M−m; P&lt;sub&gt;fail&lt;/sub&gt; = (1−q̂&lt;sub&gt;v&lt;/sub&gt;)&lt;sup&gt;R&lt;/sup&gt;&lt;br&gt;Y(v) = (1−P&lt;sub&gt;fail&lt;/sub&gt;)d(v,d) + P&lt;sub&gt;fail&lt;/sub&gt;C&lt;sub&gt;drop&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="830" width="360" height="100" as="geometry"/>
        </mxCell>
